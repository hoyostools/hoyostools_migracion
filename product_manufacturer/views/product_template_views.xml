<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_manufacturer" model="ir.ui.view">
        <field name="name">product.template.form.manufacturer</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Insertar dentro de la primera pestaña -->
            <xpath expr="//sheet/notebook/page[1]" position="inside">

                <group string="FABRICANTE" col="2">

                    <field name="manufacturer_id"/>

                    <field name="manufacturer_pref"/>

                    <field name="manufacturer_pname"/>

                    <field name="manufacturer_purl" widget="url"/>

                </group>

            </xpath>

        </field>
    </record>

</odoo>