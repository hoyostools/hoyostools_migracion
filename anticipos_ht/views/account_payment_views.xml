<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_payment_tree_inherit_anticipos" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.anticipos</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="after">

                <field name="anticipo"/>
                <field name="tipo_anticipo_id"/>

            </xpath>

        </field>
    </record>

</odoo>